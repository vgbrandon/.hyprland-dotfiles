#!/usr/bin/env python3
"""aulactl: configura el teclado AULA F75 Max por cable (USB 0C45:800A) desde Linux.

Habla con el teclado por /dev/hidraw (hace falta la regla de udev que instala chezmoi):
  - interfaz de comandos (página 0xFF13): reportes "feature" de 64 bytes
  - interfaz de la pantalla (página 0xFF68): reportes de salida de 4096 bytes

Protocolo (verificado en hardware por la comunidad, ver github.com/mohin7/aula-f75max y
github.com/parsiya/f108-pro): cada cambio es una transacción "inicio (04 18) → elegir
bloque → datos → aplicar (04 02)". Tras los pasos de control se lee la respuesta, y el
teclado acepta cuando el byte 3 vale 1. El teclado NO permite leer su configuración: lo
aplicado se guarda en ~/.local/state/aula/state.json (lo usa el panel de Quickshell).

La subida a la pantalla, los restablecimientos y Caps Lock → Ctrl siguen la app
~/aula-f75max (verificada en este teclado): tras escribir la memoria (04 02) el teclado
reinicia su conexión y hay que esperar a que vuelva a responder (wait_ready).

Uso:
  aulactl status                         estado guardado + conexión y dispositivo (JSON)
  aulactl probe                          comprueba que el teclado responde (JSON)
  aulactl clock [--12h]                  sincroniza la hora de la pantalla
  aulactl light MODO [opciones]          efecto de luces (MODO: nombre o 0-19)
  aulactl settings [opciones]            respuesta, suspensión, bloqueos, Fn
  aulactl caps-ctrl on|off               Caps Lock como Ctrl (en el firmware)
  aulactl screen ARCHIVO [--fit MODO]    imagen o GIF en la pantalla de 128×128
  aulactl screen-clear                   borra la memoria de la pantalla
  aulactl reset-data                     teclas e iluminación de fábrica
  aulactl factory-reset                  todo de fábrica, también la pantalla
"""

import argparse
import fcntl
import glob
import json
import os
import select
import shutil
import subprocess
import sys
import tempfile
import time

VID, PID = 0x0C45, 0x800A
DELAY = 0.035  # el teclado necesita ~35 ms entre paquetes
# AULA_TRACE=1: muestra cada paquete enviado y cada respuesta (para investigar el protocolo)
TRACE = os.environ.get("AULA_TRACE") == "1"


def trace(direction, data):
    if TRACE:
        print(f"{direction} {bytes(data[:16]).hex(' ')}", file=sys.stderr)


STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "aula", "state.json")
# Copia de la última imagen enviada (para la vista previa, aunque el original se borre)
SCREEN_COPY = os.path.join(os.path.dirname(STATE), "screen")

# Pantalla: trozos de 4096 bytes. Al ritmo de la app oficial (~140 ms por trozo, esperando
# su confirmación 01 5A): más deprisa, el firmware escribe la memoria a medias y salen
# líneas y ruido. Tras el 04 02 final sigue volcando la memoria ~50 ms por trozo.
CHUNK = 4096
CHUNK_INTERVAL = 0.140
COMMIT_PER_CHUNK = 0.050
COMMIT_MAX = 45.0
MAX_FRAMES = 64

# Efectos de luces del firmware (índice = el byte que se envía)
MODES = ["off", "static", "reactive", "reactive-fade", "glitter", "rain", "colourful", "breathing",
         "spectrum", "outward", "wave", "rolling", "rotating", "explode", "launch", "ripple",
         "flowing", "pulse", "tilt", "shuttle"]
DIRECTIONS = ["right", "down", "left", "up"]
SLEEP = {"never": 0, "1": 1, "5": 2, "30": 3}  # minutos -> valor del firmware

DEFAULT_STATE = {
    "light": {"mode": "rolling", "color": "#ffffff", "multicolor": True, "brightness": 4, "speed": 3, "direction": "right"},
    "settings": {"response": 1, "sleep": "5", "winLock": False, "altF4Lock": False, "altTabLock": False, "fnSwitch": False},
    "screen": {"file": "", "fit": "fill"},
    "clock": {"twelveHour": False, "lastSync": 0},
    "keys": {"capsCtrl": False},
}
# Lo que deja el restablecimiento de fábrica
FACTORY_LIGHT = {"mode": "rolling", "color": "#ffffff", "multicolor": False, "brightness": 5, "speed": 3,
                 "direction": "right"}


class AulaError(Exception):
    pass


# --- ioctl de hidraw (linux/hidraw.h) ---
def _ioc(direction, nr, size):
    return (direction << 30) | (size << 16) | (ord("H") << 8) | nr


def HIDIOCSFEATURE(size):
    return _ioc(3, 0x06, size)


def HIDIOCGFEATURE(size):
    return _ioc(3, 0x07, size)


def find_hidraw(usage_page):
    """El /dev/hidrawN del teclado cuyo descriptor empieza por la página de uso dada."""
    marker = bytes([0x06, usage_page & 0xFF, usage_page >> 8])
    for path in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(f"{path}/device/uevent") as f:
                uevent = f.read()
            if f"HID_ID=0003:{VID:08X}:{PID:08X}" not in uevent:
                continue
            with open(f"{path}/device/report_descriptor", "rb") as f:
                if f.read(3) == marker:
                    return "/dev/" + os.path.basename(path)
        except OSError:
            continue
    return None


def firmware(hidraw_path):
    """Versión del firmware: el bcdDevice del USB (p. ej. 1.08)."""
    try:
        node = os.path.realpath(f"/sys/class/hidraw/{os.path.basename(hidraw_path)}/device/../..")
        with open(os.path.join(node, "bcdDevice")) as f:
            value = int(f.read().strip(), 16)
        return f"{value >> 8}.{value & 0xFF:02d}"
    except (OSError, ValueError):
        return None


def packet(*fields, **at):
    """64 bytes: los primeros valores en orden; at={índice: valor} para los demás."""
    data = bytearray(64)
    for i, value in enumerate(fields):
        data[i] = value
    for key, value in at.items():
        data[int(key[1:])] = value
    return bytes(data)


class Keyboard:
    def __init__(self):
        self.fd = None
        self.open()

    def open(self):
        path = find_hidraw(0xFF13)
        if not path:
            raise AulaError("No se encontró el AULA F75 Max conectado por cable (USB 0C45:800A).")
        try:
            self.fd = os.open(path, os.O_RDWR)
        except PermissionError:
            raise AulaError(f"Sin permiso para {path}: falta la regla de udev (chezmoi apply y reconectar el teclado).")

    def close(self):
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None

    def command(self, *fields, delay=0.04, retries=3, check=True, **at):
        """Envía un paquete y lee la respuesta, con reintentos (una respuesta vacía, 00 00,
        es que aún no está lista). check: el teclado debe confirmar (byte 3 = 1)."""
        data = packet(*fields, **at)
        last = None
        for _ in range(retries):
            try:
                time.sleep(delay)
                trace(">>", data)
                self.set_feature(data)
                time.sleep(delay)
                reply = self.get_feature()
                trace("<<", reply)
                if reply[:2] != b"\x00\x00":
                    if check and reply[3] != 0x01:
                        raise AulaError(f"El teclado no confirmó el comando {data[0]:02X} {data[1]:02X}.")
                    return reply
                last = "respuesta vacía"
            except OSError as e:
                last = e
                time.sleep(0.05)
        raise AulaError(f"El teclado no respondió ({last}).")

    def send(self, data):
        time.sleep(DELAY)
        trace(">>", data)
        self.set_feature(data)

    def wait_ready(self, timeout=20.0):
        """Tras escribir su memoria el teclado reinicia la conexión: espera a que vuelva a
        responder (reabriéndolo si hace falta)."""
        deadline = time.monotonic() + timeout
        while True:
            try:
                if self.fd is None:
                    self.open()
                self.command(0x04, 0x18, delay=0.06, retries=1)
                return
            except (AulaError, OSError):
                self.close()
                if time.monotonic() >= deadline:
                    raise AulaError("El teclado no volvió a responder.")
                time.sleep(0.5)

    def finish_flash(self):
        """Aplica (04 02) y reinicia (04 F0): pasos que escriben la memoria, con eco."""
        self.command(0x04, 0x02, delay=0.08, check=False)
        try:
            self.command(0x04, 0xF0, delay=0.08, check=False, retries=1)
        except AulaError:
            pass

    def zero_pages(self, count):
        """count páginas a cero (la última se lee sin comprobar)."""
        zero = bytes(64)
        for _ in range(count):
            self.send(zero)
        time.sleep(DELAY)
        try:
            self.get_feature()
        except OSError:
            pass

    def set_feature(self, data):
        buf = bytearray(65)  # byte 0 = número de reporte (0: el teclado no usa IDs)
        buf[1:] = data
        fcntl.ioctl(self.fd, HIDIOCSFEATURE(65), buf)

    def get_feature(self):
        buf = bytearray(65)
        fcntl.ioctl(self.fd, HIDIOCGFEATURE(65), buf)
        return bytes(buf[1:])

    def run(self, steps):
        """steps: [(tipo, paquete)]. Tipos: "ack" (debe confirmar), "echo" (se lee la
        respuesta sin comprobarla), "send" (solo se envía)."""
        for kind, data in steps:
            time.sleep(DELAY)
            trace(">>", data)
            self.set_feature(data)
            if kind in ("ack", "echo"):
                time.sleep(DELAY)
                reply = self.get_feature()
                trace("<<", reply)
                if kind == "ack" and reply[3] != 0x01:
                    raise AulaError(f"El teclado no confirmó el comando {data[0]:02X} {data[1]:02X}.")


BEGIN = ("ack", packet(0x04, 0x18))
APPLY = ("ack", packet(0x04, 0x02))
FINISH = ("send", packet(0x04, 0xF0))


# --- Comandos ---
def clock_steps(twelve_hour=False):
    now = time.localtime()
    hour = now.tm_hour
    if twelve_hour:
        hour = hour % 12 or 12
    data = packet(0x00, 0x01, 0x5A, (now.tm_year - 2000) % 100, now.tm_mon, now.tm_mday,
                  hour, now.tm_min, now.tm_sec, 0x00, (now.tm_wday + 1) % 7, b62=0xAA, b63=0x55)
    return [BEGIN, ("ack", packet(0x04, 0x28, b8=0x01)), ("echo", data), APPLY]


def light_steps(light):
    mode = MODES.index(light["mode"])
    data = bytearray(64)
    data[0] = mode
    if mode != 0:
        color = light["color"].lstrip("#")
        data[1:4] = bytes.fromhex(color)
        data[8] = 1 if light["multicolor"] else 0
        data[9] = light["brightness"]
        data[10] = light["speed"]
        data[11] = DIRECTIONS.index(light["direction"])
    data[14], data[15] = 0xAA, 0x55
    return [BEGIN, ("ack", packet(0x04, 0x13, b8=0x01)), ("send", bytes(data)), APPLY, FINISH]


def settings_steps(s):
    data = packet(0x00, 0x01, int(s["winLock"]), int(s["altF4Lock"]), int(s["altTabLock"]),
                  int(s["fnSwitch"]), SLEEP[s["sleep"]], 0x00, s["response"], b62=0xAA, b63=0x55)
    return [BEGIN, ("ack", packet(0x04, 0x17, 0x01, b8=0x01)), ("send", data), APPLY]


def encode_screen(path, fit):
    """Imagen/GIF -> flujo de la pantalla: cabecera de 256 bytes (fotogramas, su duración
    en unidades de 2 ms y el resto 0xFF) + fotogramas 128×128 RGB565 little-endian, en
    bloques de 4096."""
    size = 128
    filters = {
        "fit": f"scale={size}:{size}:force_original_aspect_ratio=decrease:flags=lanczos,pad={size}:{size}:(ow-iw)/2:(oh-ih)/2:black",
        "fill": f"scale={size}:{size}:force_original_aspect_ratio=increase:flags=lanczos,crop={size}:{size}",
        "stretch": f"scale={size}:{size}:flags=lanczos",
    }[fit]
    with tempfile.TemporaryDirectory() as tmp:
        raw = os.path.join(tmp, "frames.raw")
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", path, "-frames:v", str(MAX_FRAMES), "-vf", filters,
                        "-pix_fmt", "rgb565le", "-f", "rawvideo", raw], check=True)
        with open(raw, "rb") as f:
            pixels = f.read()
    frame_size = size * size * 2
    count = len(pixels) // frame_size
    if count == 0:
        raise AulaError("No se pudo leer ningún fotograma de la imagen.")
    # Duración de cada fotograma (si es una imagen fija, da igual)
    probe = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                            "frame=duration_time", "-of", "csv=p=0", path], capture_output=True, text=True)
    delays = []
    for line in probe.stdout.split():
        try:
            delays.append(float(line.strip(",")))
        except ValueError:
            pass
    # Cabecera: nº de fotogramas y la duración de cada uno (unidades de 2 ms); el resto a
    # cero, igual que el relleno de la última página (como la app verificada, que borra
    # la memoria antes de cada subida)
    header = bytearray(256)
    header[0] = count
    for i in range(count):
        ms = delays[i] * 1000 if i < len(delays) and delays[i] > 0 else 100
        header[1 + i] = max(1, min(255, round(ms / 2)))
    stream = bytes(header) + pixels[:count * frame_size]
    stream += bytes(-len(stream) % CHUNK)
    return stream, count


def clear_screen(kb):
    """Borra la memoria de la pantalla: la tabla de huecos de imagen (bloque 04 15, 8
    páginas a cero), donde siguen apuntados los fotogramas anteriores (y la animación de
    fábrica). La app oficial lo hace antes de cada subida: si no, el firmware mezcla
    restos y salen líneas y parpadeos."""
    # Tras una subida tarda un poco en aceptar otra sesión: se reintenta
    deadline = time.monotonic() + 8
    while True:
        try:
            kb.command(0x04, 0x19, delay=0.06)
            break
        except AulaError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.5)
    kb.command(0x04, 0x15, b8=0x08)
    kb.zero_pages(8)
    kb.command(0x04, 0x02, delay=0.08, check=False)
    kb.wait_ready(10)


def upload_screen(kb, stream, slot=1, progress=None):
    display_path = find_hidraw(0xFF68)
    if not display_path:
        raise AulaError("No se encontró la interfaz de la pantalla del teclado (hace falta el cable USB-C).")
    chunks = len(stream) // CHUNK
    if progress:
        progress("clear", 0, 1)
    clear_screen(kb)
    time.sleep(0.2)
    fd = os.open(display_path, os.O_RDWR)
    try:
        kb.command(0x04, 0x18)
        kb.command(0x04, 0x72, slot, b8=chunks & 0xFF, b9=chunks >> 8)
        # Descarta confirmaciones viejas
        for _ in range(8):
            if not select.select([fd], [], [], 0.12)[0]:
                break
            os.read(fd, 512)
        for i in range(chunks):
            started = time.monotonic()
            # Reporte de salida: byte 0 = número de reporte (0), que el kernel quita. Sin
            # él, los bloques que empiezan por 0x00 pierden su primer byte.
            trace(f">> trozo {i + 1}/{chunks}:", stream[i * CHUNK:(i + 1) * CHUNK])
            os.write(fd, b"\x00" + stream[i * CHUNK:(i + 1) * CHUNK])
            # El teclado confirma cada trozo con 01 5A 02 antes del siguiente
            if not select.select([fd], [], [], 1.5)[0]:
                raise AulaError(f"El teclado no confirmó el trozo {i + 1} de la imagen.")
            ack = os.read(fd, 512)
            trace("<< confirmación:", ack)
            if ack[:2] != b"\x01\x5a":
                raise AulaError(f"Respuesta inesperada de la pantalla: {ack[:8].hex(' ')}")
            remaining = CHUNK_INTERVAL - (time.monotonic() - started)
            if remaining > 0:
                time.sleep(remaining)
            if progress:
                progress("upload", i + 1, chunks)
        kb.command(0x04, 0x02)
        # El firmware sigue volcando la memoria: darle tiempo antes de hablarle
        wait = min(COMMIT_MAX, max(1.0, chunks * COMMIT_PER_CHUNK))
        if progress:
            progress("commit", 0, round(wait))
        time.sleep(wait)
    finally:
        os.close(fd)
    try:
        kb.wait_ready(10)
    except AulaError:
        pass  # la imagen ya está; si reinicia justo ahora no es un error
    return chunks


# --- Restablecer ---
def reset_keymap(kb):
    """Teclas y macros de fábrica (bloque 04 11, 9 páginas a cero)."""
    kb.command(0x04, 0x18)
    kb.command(0x04, 0x11, b8=0x09)
    kb.zero_pages(9)
    kb.finish_flash()


def reset_lighting(kb):
    """Iluminación de fábrica (bloque 04 27, 9 páginas a cero)."""
    kb.command(0x04, 0x18)
    kb.command(0x04, 0x27, b8=0x09)
    kb.zero_pages(9)
    kb.finish_flash()


def reset_footer(kb):
    """El cierre que hace la app oficial antes de la configuración de la pantalla."""
    kb.command(0x04, 0x18)
    kb.command(0x04, 0x13, b8=0x01)
    kb.command(0x0B, 0xFF, b8=0x01, b9=0x05, b10=0x03, b14=0xAA, b15=0x55, check=False)
    kb.finish_flash()


def reset_display_config(kb):
    """La pantalla en el hueco 1 y con su configuración de fábrica."""
    kb.command(0x04, 0x18)
    kb.command(0x04, 0x17, 0x01, b8=0x01)
    kb.command(0x00, 0x01, b6=0x02, b8=0x02, check=False)
    kb.command(0x04, 0x02)


def stage(kb, fn):
    """Cada paso del restablecimiento, con el teclado ya listo de nuevo."""
    kb.wait_ready()
    fn(kb)
    time.sleep(0.5)


# --- Teclas ---
def caps_ctrl(kb, enabled):
    """Caps Lock como Ctrl, en el mapa de teclas del firmware (bloque 04 11)."""
    kb.command(0x04, 0x18)
    kb.command(0x04, 0x11, b8=0x09)
    try:
        kb.command(0x02, 0x01 if enabled else 0x00, check=False)
        kb.command(0x04, 0x02, check=False)
    finally:
        try:
            kb.command(0x04, 0xF0, delay=0.08, check=False, retries=1)
        except AulaError:
            pass
    kb.wait_ready()


# --- Estado guardado ---
def load_state():
    state = json.loads(json.dumps(DEFAULT_STATE))
    try:
        with open(STATE) as f:
            saved = json.load(f)
        for key, value in saved.items():
            if isinstance(value, dict) and key in state:
                state[key].update(value)
    except (OSError, ValueError):
        pass
    return state


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, STATE)


def on_off(value):
    return value in ("on", "1", "true", "si", "sí", "yes")


def main():
    parser = argparse.ArgumentParser(prog="aulactl", description="Configura el AULA F75 Max por cable.")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="estado guardado, conexión y dispositivo (JSON)")
    sub.add_parser("probe", help="comprueba que el teclado responde (JSON)")
    p = sub.add_parser("caps-ctrl", help="Caps Lock como Ctrl")
    p.add_argument("state", choices=["on", "off"])
    sub.add_parser("reset-data", help="teclas e iluminación de fábrica")
    sub.add_parser("factory-reset", help="todo de fábrica, también la pantalla")

    p = sub.add_parser("clock", help="sincroniza la hora de la pantalla")
    p.add_argument("--12h", dest="twelve", action="store_true", help="formato de 12 horas")

    p = sub.add_parser("light", help="efecto de luces")
    p.add_argument("mode", help="nombre (" + ", ".join(MODES) + ") o número 0-19")
    p.add_argument("--color", help="color #RRGGBB")
    p.add_argument("--multicolor", choices=["on", "off"])
    p.add_argument("--brightness", type=int, choices=range(1, 6))
    p.add_argument("--speed", type=int, choices=range(1, 6))
    p.add_argument("--direction", choices=DIRECTIONS)

    p = sub.add_parser("settings", help="ajustes del teclado")
    p.add_argument("--response", type=int, choices=range(1, 6), help="tiempo de respuesta (1 = más rápido)")
    p.add_argument("--sleep", choices=list(SLEEP), help="suspensión en minutos (never = nunca)")
    p.add_argument("--win-lock", choices=["on", "off"])
    p.add_argument("--alt-f4-lock", choices=["on", "off"])
    p.add_argument("--alt-tab-lock", choices=["on", "off"])
    p.add_argument("--fn-switch", choices=["on", "off"])

    sub.add_parser("screen-clear", help="borra la memoria de la pantalla (también la animación de fábrica)")

    p = sub.add_parser("screen", help="imagen o GIF en la pantalla")
    p.add_argument("file")
    p.add_argument("--fit", choices=["fit", "fill", "stretch"], default="fill")

    args = parser.parse_args()
    state = load_state()

    if args.command == "status":
        command_path = find_hidraw(0xFF13)
        display_path = find_hidraw(0xFF68)
        state["connected"] = command_path is not None
        state["modes"] = MODES
        state["device"] = {
            "model": "AULA F75 Max",
            "transport": "usb" if command_path else None,
            "firmware": firmware(command_path) if command_path else None,
            "commandPath": command_path,
            "displayPath": display_path,
            "access": bool(command_path) and os.access(command_path, os.R_OK | os.W_OK),
        }
        print(json.dumps(state))
        return

    kb = Keyboard()
    try:
        if args.command == "clock":
            kb.run(clock_steps(args.twelve))
            state["clock"] = {"twelveHour": args.twelve, "lastSync": int(time.time())}

        elif args.command == "light":
            light = dict(state["light"])
            light["mode"] = MODES[int(args.mode)] if args.mode.isdigit() else args.mode
            if light["mode"] not in MODES:
                raise AulaError(f"Efecto desconocido: {args.mode}")
            if args.color:
                light["color"] = "#" + args.color.lstrip("#").lower()
            if args.multicolor:
                light["multicolor"] = on_off(args.multicolor)
            for key in ("brightness", "speed", "direction"):
                if getattr(args, key) is not None:
                    light[key] = getattr(args, key)
            kb.run(light_steps(light))
            state["light"] = light

        elif args.command == "settings":
            s = dict(state["settings"])
            if args.response:
                s["response"] = args.response
            if args.sleep:
                s["sleep"] = args.sleep
            for arg, key in (("win_lock", "winLock"), ("alt_f4_lock", "altF4Lock"),
                             ("alt_tab_lock", "altTabLock"), ("fn_switch", "fnSwitch")):
                if getattr(args, arg):
                    s[key] = on_off(getattr(args, arg))
            kb.run(settings_steps(s))
            state["settings"] = s

        elif args.command == "probe":
            reply = kb.command(0x04, 0x18)
            print(json.dumps({"ok": True, "reply": reply[:16].hex(" ")}))
            return

        elif args.command == "screen-clear":
            clear_screen(kb)
            state["screen"] = {"file": "", "fit": state["screen"].get("fit", "fill")}

        elif args.command == "screen":
            stream, frames = encode_screen(args.file, args.fit)

            # Progreso: "progress ETAPA HECHO TOTAL" (clear, upload, commit en segundos)
            def progress(step, done, total):
                print(f"progress {step} {done} {total}", flush=True)

            chunks = upload_screen(kb, stream, progress=progress)
            # Copia estable para la vista previa (el original puede estar en /tmp)
            stored = os.path.abspath(args.file)
            try:
                os.makedirs(os.path.dirname(SCREEN_COPY), exist_ok=True)
                copy = SCREEN_COPY + (os.path.splitext(args.file)[1].lower() or ".png")
                for old in glob.glob(SCREEN_COPY + ".*"):
                    if old != copy:
                        os.remove(old)
                shutil.copyfile(args.file, copy)
                stored = copy
            except OSError:
                pass
            state["screen"] = {"file": stored, "fit": args.fit, "frames": frames}
            print(f"Pantalla: {frames} fotograma(s) en {chunks} trozos", file=sys.stderr)

        elif args.command == "caps-ctrl":
            enabled = on_off(args.state)
            caps_ctrl(kb, enabled)
            state["keys"] = {"capsCtrl": enabled}

        elif args.command in ("reset-data", "factory-reset"):
            factory = args.command == "factory-reset"
            if factory:
                kb.wait_ready()
                clear_screen(kb)
                time.sleep(0.3)
            stage(kb, reset_keymap)
            stage(kb, reset_lighting)
            if factory:
                stage(kb, reset_footer)
                kb.wait_ready()
                reset_display_config(kb)
                state["screen"] = {"file": "", "fit": "fill"}
            kb.wait_ready()
            state["light"] = dict(FACTORY_LIGHT)
            state["keys"] = {"capsCtrl": False}

        save_state(state)
    finally:
        kb.close()


if __name__ == "__main__":
    try:
        main()
    except AulaError as e:
        print(f"aulactl: {e}", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        print(f"aulactl: no se pudo convertir la imagen ({e})", file=sys.stderr)
        sys.exit(1)

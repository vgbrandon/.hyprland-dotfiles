// Pantalla de carga de Plymouth: solo el logo de Arch, centrado sobre negro (el
// mismo negro en el que empieza la pantalla de inicio de sesión). La imagen la
// genera install.sh con el color del texto del tema.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetOpacity(0);

// Centrado en el monitor principal
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;
logo_sprite.SetPosition(cx - logo.GetWidth() / 2, cy - logo.GetHeight() / 2, 1);

fade = 0;

// Plymouth llama a esto ~50 veces por segundo: entrada con fundido
fun refresh_callback() {
    if (fade < 1) {
        fade = fade + 0.05;
        if (fade > 1) fade = 1;
        logo_sprite.SetOpacity(fade);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// Mensajes del sistema (p. ej. revisión del disco): texto pequeño abajo
message_sprite = Sprite();
fun message_callback(text) {
    message_sprite.SetImage(Image.Text(text, 0.6, 0.6, 0.65));
    message_sprite.SetPosition(cx - message_sprite.GetImage().GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 2);
}
Plymouth.SetMessageFunction(message_callback);

// velure: generado desde el fondo de pantalla. No editar a mano: se sobrescribe al
// cambiar el fondo; los cambios van en ~/.config/velure/templates/fastfetch.jsonc.
// Los iconos de las claves, en el acento exacto del tema (color real, sin ANSI).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii/arch.txt",
        // El dibujo, en el acento de Velure (sin marcas de color, todo usa el color 1)
        "color": { "1": "{{colors.p_accent.default.hex}}" },
        "padding": {
            "top": 0,
            "right": 6
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	{
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "{{colors.p_accent.default.hex}}",  // el acento de Velure
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "{{colors.p_accent.default.hex}}",
        },
        {
            "type": "packages",
            "format": "{pacman} (pacman)",
            "key": " ",
            "keyColor": "{{colors.p_accent.default.hex}}",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "{{colors.p_accent.default.hex}}", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "{{colors.p_accent.default.hex}}", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "{{colors.p_accent.default.hex}}", 
        },
    ]
}

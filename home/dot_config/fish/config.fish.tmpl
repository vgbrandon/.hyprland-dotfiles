if status is-interactive
    # Eliminando mensaje de saludo de Fish
    function fish_greeting; end

    # eza (better 'ls')
    if type -q eza
        alias l="eza --icons"
        alias ls="eza --icons"
        alias ll="eza -lg --icons"
        alias la="eza -lag --icons"
        alias lt="eza -lTg --icons"
        alias lt1="eza -lTg --level=1 --icons"
        alias lt2="eza -lTg --level=2 --icons"
        alias lt3="eza -lTg --level=3 --icons"
        alias lta="eza -lTag --icons"
        alias lta1="eza -lTag --level=1 --icons"
        alias lta2="eza -lTag --level=2 --icons"
        alias lta3="eza -lTag --level=3 --icons"
    end

    # pnpm
    set -gx PNPM_HOME "$HOME/.local/share/pnpm"
    fish_add_path -m "$PNPM_HOME"
    # pnpm end

    # Asegurar binarios locales
    fish_add_path -m "$HOME/.local/bin"

    if type -q zoxide
        zoxide init fish | source
    end

    # opencode
    fish_add_path -m "$HOME/.opencode/bin"

    # Esto siempre debe ir al final
    if type -q starship
        # Colores del fondo de pantalla (matugen); si no hay, el starship.toml normal
        sh "$HOME/.config/matugen/scripts/starship.sh" 2>/dev/null
        if test -f "$HOME/.config/starship/starship-matugen.toml"
            set -gx STARSHIP_CONFIG "$HOME/.config/starship/starship-matugen.toml"
        else
            set -gx STARSHIP_CONFIG "$HOME/.config/starship/starship.toml"
        end
        starship init fish | source

        # Repinta el prompt cuando matugen cambia los colores (avisa con SIGUSR1
        # solo a las terminales registradas aquí)
        function __matugen_repaint --on-signal SIGUSR1
            commandline -f repaint
        end
        set -l matugen_dir "$XDG_RUNTIME_DIR/matugen-fish"
        mkdir -p $matugen_dir; and touch $matugen_dir/$fish_pid
        function __matugen_unregister --on-event fish_exit
            rm -f "$XDG_RUNTIME_DIR/matugen-fish/$fish_pid"
        end
    end
end

{{ if .deepseekApiKey -}}
# DeepSeek API Key para Zed
set -gx DEEPSEEK_API_KEY "{{ .deepseekApiKey }}"
{{ else -}}
# DeepSeek API Key para Zed (no configurada: se omitió en 'chezmoi init')
# set -gx DEEPSEEK_API_KEY "..."
{{ end -}}

# opencode
fish_add_path {{ .chezmoi.homeDir }}/.opencode/bin

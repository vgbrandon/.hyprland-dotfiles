// Base de fastfetch: qué módulos se muestran y cómo. velure le pone los colores del
// fondo de pantalla (el logo, el título y las claves, en el primario) y escribe
// config.jsonc. Los cambios van aquí, no en config.jsonc.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii/arch.txt",
        "padding": { "top": 0, "right": 6 }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        { "type": "title", "keyWidth": 10 },
        "break",
        { "type": "os", "key": " " },
        { "type": "kernel", "key": " " },
        { "type": "packages", "format": "{pacman} (pacman)", "key": " " },
        { "type": "shell", "key": " " },
        { "type": "terminal", "key": " " },
        { "type": "wm", "key": " " }
    ]
}

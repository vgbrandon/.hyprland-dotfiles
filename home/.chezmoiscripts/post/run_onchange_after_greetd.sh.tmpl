#!/usr/bin/env bash
set -euo pipefail

# Instala la pantalla de inicio de sesión (greetd + Quickshell) en /etc/greetd.
# (Que greetd quede activado lo comprueba run_after_greetd-enable.sh.)
# Se vuelve a ejecutar cuando cambia algún archivo del greeter, los componentes
# que comparte con la sesión normal o los monitores:
{{ range (glob (joinPath .chezmoi.sourceDir "dot_config/quickshell-greeter/*.*")) -}}
# {{ base . }}: {{ include . | sha256sum }}
{{ end -}}
{{ range (glob (joinPath .chezmoi.sourceDir "dot_config/quickshell-greeter/services/*.qml")) -}}
# services/{{ base . }}: {{ include . | sha256sum }}
{{ end -}}
# Pill.qml: {{ include "dot_config/quickshell/components/base/Pill.qml" | sha256sum }}
# Icon.qml: {{ include "dot_config/quickshell/components/base/Icon.qml" | sha256sum }}
# Label.qml: {{ include "dot_config/quickshell/components/base/Label.qml" | sha256sum }}
# Avatar.qml: {{ include "dot_config/quickshell/components/base/Avatar.qml" | sha256sum }}
# monitors.lua: {{ include "dot_config/hypr/monitors.lua" | sha256sum }}

"$HOME/.config/quickshell-greeter/install.sh"

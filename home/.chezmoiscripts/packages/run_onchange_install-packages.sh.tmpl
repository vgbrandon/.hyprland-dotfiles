#!/usr/bin/env bash
set -euo pipefail

# Este script se vuelve a ejecutar automáticamente cada vez que cambia
# el contenido de .chezmoidata/packages.yaml o el flag enableAur.
# hash de paquetes: {{ .packages | toJson | sha256sum }}
# aur habilitado: {{ .enableAur }}

echo "[INFO] Instalando paquetes base y oficiales..."

PACKAGES=(
{{ range (concat .packages.base .packages.pacman) }}  "{{ . }}"
{{ end }}
)

sudo pacman -S --needed --noconfirm "${PACKAGES[@]}"

{{ if .enableAur -}}
if ! command -v yay >/dev/null 2>&1; then
  echo "[INFO] Instalando yay..."
  tmp_dir="$(mktemp -d)"
  git clone https://aur.archlinux.org/yay.git "$tmp_dir/yay"
  (cd "$tmp_dir/yay" && makepkg --noconfirm && sudo pacman -U --noconfirm ./*.pkg.tar.zst)
  rm -rf "$tmp_dir"
fi

echo "[INFO] Instalando paquetes AUR..."

AUR_PACKAGES=(
{{ range .packages.aur }}  "{{ . }}"
{{ end }}
)

yay -S --needed --noconfirm "${AUR_PACKAGES[@]}"
{{ else -}}
echo "[WARN] AUR deshabilitado (enableAur=false en 'chezmoi init'). Paquetes omitidos: {{ .packages.aur | join ", " }}"
echo "[WARN] Para habilitarlo: chezmoi data | grep enableAur, y editá ~/.config/chezmoi/chezmoi.toml"
{{ end -}}

echo "[INFO] Quitando paquetes que no se usan..."

REMOVE_PACKAGES=(
{{ range .packages.remove }}  "{{ . }}"
{{ end }}
)

installed=()
for pkg in "${REMOVE_PACKAGES[@]}"; do
  if pacman -Qq "$pkg" >/dev/null 2>&1; then
    installed+=("$pkg")
  fi
done
if [ "${#installed[@]}" -gt 0 ]; then
  # Solo esos paquetes (-Rn, sin -s): sus dependencias pueden usarlas otros programas
  # (dolphin arrastraría ~70, entre ellos sound-theme-freedesktop o ripgrep). Las que
  # queden sin uso se ven con: pacman -Qdtq
  # Si otro paquete depende de alguno, pacman no lo quita: se avisa y se sigue
  sudo pacman -Rn --noconfirm "${installed[@]}" \
    || echo "[WARN] No se pudo quitar: ${installed[*]} (¿lo necesita otro paquete?)"
fi

echo "[OK] Paquetes instalados correctamente."
